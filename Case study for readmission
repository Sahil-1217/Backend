def run_data_quality_audit(df):
    """
    Produces comprehensive Data Quality Report identifying missing values,
    duplicates, invalid ranges, and clinical outliers.
    """
    print("=" * 78)
    print("                      DATA QUALITY ASSESSMENT REPORT                      ")
    print("=" * 78)
    
    # 1. Duplicates
    dup_count = df.duplicated(subset=['Patient_ID']).sum()
    print(f"[*] Duplicate Patient_IDs Detected: {dup_count} records")
    
    # 2. Missing Values Summary
    missing_series = df.isnull().sum()
    missing_pct = (missing_series / len(df)) * 100
    dq_missing = pd.DataFrame({'Missing_Count': missing_series, 'Pct_Missing': missing_pct})
    dq_missing = dq_missing[dq_missing['Missing_Count'] > 0].sort_values(by='Pct_Missing', ascending=False)
    print("\n[*] Missing Value Distribution:")
    print(dq_missing.to_string())
    
    # 3. Invalid Value Violations
    invalid_age = df[(df['Age'] < 0) | (df['Age'] > 120)]['Age'].count()
    invalid_los = df[df['Length_Of_Stay'] < 0]['Length_Of_Stay'].count()
    print(f"\n[*] Boundary Rule Violations:")
    print(f"    - Invalid Age (<0 or >120): {invalid_age} records")
    print(f"    - Invalid Length_Of_Stay (<0): {invalid_los} records")
    
    # 4. Outlier Detection
    q99 = df['Total_Claim_Cost'].quantile(0.999)
    outlier_claims = df[df['Total_Claim_Cost'] > q99]['Total_Claim_Cost'].count()
    print(f"\n[*] Extreme Outliers: {outlier_claims} claims exceed 99.9th percentile (${q99:,.2f})")
    print("=" * 78)

run_data_quality_audit(raw_df)

def clean_data_pipeline(df):
    """
    Executes disciplined clinical data remediation pipeline:
    - Deduplicates patient records
    - Filters out 'Expired' discharges (non-eligible readmission risk)
    - Removes domain-impossible records (Age < 0, Age > 120, LOS < 0)
    - Imputes numerical features via median and categoricals via mode/Missing indicator
    - Caps financial outliers at 99.5th percentile
    """
    df_clean = df.copy()
    
    # 1. Deduplicate by Patient_ID
    df_clean = df_clean.drop_duplicates(subset=['Patient_ID'], keep='first')
    
    # 2. Filter non-eligible deceased records
    df_clean = df_clean[df_clean['Discharge_Disposition'] != 'Expired']
    
    # 3. Clean invalid domain bounds
    df_clean = df_clean[(df_clean['Age'] >= 0) & (df_clean['Age'] <= 120)]
    df_clean = df_clean[df_clean['Length_Of_Stay'] >= 0]
    
    # 4. Impute Missing Values
    df_clean['BMI'] = df_clean['BMI'].fillna(df_clean['BMI'].median())
    df_clean['Pharmacy_Cost'] = df_clean['Pharmacy_Cost'].fillna(df_clean['Pharmacy_Cost'].median())
    df_clean['Smoking_Status'] = df_clean['Smoking_Status'].fillna('Never')
    df_clean['Marital_Status'] = df_clean['Marital_Status'].fillna('Unknown')
    
    # 5. Cap extreme financial outliers (capping at 99.5th percentile to prevent model skew)
    cap_cost = df_clean['Total_Claim_Cost'].quantile(0.995)
    df_clean['Total_Claim_Cost'] = np.clip(df_clean['Total_Claim_Cost'], a_min=0, a_max=cap_cost)
    
    return df_clean

