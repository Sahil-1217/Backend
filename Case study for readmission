def engineer_features(df):
    """
    Engineers derived clinical indexes and utilization ratios while
    strictly dropping non-operational and target leakage variables.
    """
    df_feat = df.copy()
    
    # 1. Chronic Burden Index: Composite sum of five major chronic conditions
    df_feat['Chronic_Burden_Index'] = (
        df_feat['Diabetes'] +
        df_feat['Hypertension'] +
        df_feat['Heart_Disease'] +
        df_feat['COPD'] +
        df_feat['Kidney_Disease']
    )
    
    # 2. Utilization Risk Index: Aggregate prior encounters
    df_feat['Utilization_Risk_Index'] = (
        df_feat['Previous_Admissions'] +
        df_feat['ER_Visits_Last_12M'] +
        df_feat['Specialist_Visits_Last_12M']
    )
    
    # 3. Cost Per Encounter: Ratio of financial spend to acute episodes
    df_feat['Cost_Per_Encounter'] = df_feat['Total_Claim_Cost'] / (df_feat['ER_Visits_Last_12M'] + 1.0)
    
    # 4. Pharmacy Cost Ratio: Proportion of claim spend driven by pharmaceuticals
    df_feat['Pharmacy_Cost_Ratio'] = df_feat['Pharmacy_Cost'] / (df_feat['Total_Claim_Cost'] + 1.0)
    
    # --------------------------------------------------------------------------
    # LEAKAGE & METADATA PURGE
    # - Days_To_Next_Admission: Known only in future after re-hospitalization
    # - Patient_ID: Non-predictive unique key
    # --------------------------------------------------------------------------
    leakage_cols = ['Days_To_Next_Admission', 'Patient_ID']
    df_feat = df_feat.drop(columns=leakage_cols, errors='ignore')
    
    return df_feat

