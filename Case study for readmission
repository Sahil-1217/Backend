def generate_capstone_dataset(n_samples=50000):
    """
    Generates synthetic healthcare dataset strictly aligned with Data Dictionary,
    injecting realistic clinical correlation and intentional data quality defects.
    """
    np.random.seed(42)
    
    patient_ids = [f"PAT_{i:06d}" for i in range(1, n_samples + 1)]
    age = np.random.randint(18, 88, size=n_samples)
    gender = np.random.choice(['Male', 'Female', 'Other'], size=n_samples, p=[0.48, 0.50, 0.02])
    bmi = np.random.normal(loc=28.5, scale=6.0, size=n_samples)
    smoking_status = np.random.choice(['Never', 'Former', 'Current'], size=n_samples, p=[0.55, 0.25, 0.20])
    marital_status = np.random.choice(['Married', 'Single', 'Divorced', 'Widowed'], size=n_samples, p=[0.50, 0.25, 0.15, 0.10])
    
    # Chronic conditions (higher probability with age)
    p_chronic = np.clip((age - 18) / 100.0, 0.05, 0.85)
    diabetes = (np.random.rand(n_samples) < p_chronic * 0.45).astype(int)
    hypertension = (np.random.rand(n_samples) < p_chronic * 0.60).astype(int)
    heart_disease = (np.random.rand(n_samples) < p_chronic * 0.35).astype(int)
    copd = (np.random.rand(n_samples) < p_chronic * 0.20).astype(int)
    kidney_disease = (np.random.rand(n_samples) < p_chronic * 0.18).astype(int)
    chronic_condition_count = diabetes + hypertension + heart_disease + copd + kidney_disease
    
    # Healthcare Utilization
    prev_admissions = np.random.poisson(lam=0.4 + 0.5 * chronic_condition_count)
    er_visits = np.random.poisson(lam=0.6 + 0.6 * chronic_condition_count)
    specialist_visits = np.random.poisson(lam=1.0 + 0.8 * chronic_condition_count)
    total_medications = np.clip(np.random.poisson(lam=3 + 2.5 * chronic_condition_count), 0, 30)
    
    # Current Hospitalization
    los = np.clip(np.random.poisson(lam=2.5 + 0.8 * chronic_condition_count + 1.2 * prev_admissions), 1, 35)
    icu_admission = (np.random.rand(n_samples) < (0.05 + 0.04 * chronic_condition_count + 0.02 * los)).astype(int)
    surgery_performed = np.random.choice([0, 1], size=n_samples, p=[0.68, 0.32])
    discharge_disp = np.random.choice(['Home', 'Skilled Nursing Facility', 'Rehab', 'Expired'],
                                      size=n_samples, p=[0.75, 0.15, 0.08, 0.02])
    
    # Financial metrics
    base_cost = 2500 + los * 1400 + icu_admission * 6500 + surgery_performed * 9000
    claim_cost = np.random.normal(loc=base_cost, scale=base_cost * 0.18)
    pharmacy_cost = np.random.normal(loc=total_medications * 180 + 350, scale=120)
    lab_cost = np.random.normal(loc=los * 280 + 400, scale=150)
    imaging_cost = np.random.normal(loc=icu_admission * 850 + surgery_performed * 750 + 300, scale=100)
    
    # Care Management
    followup_scheduled = np.random.choice([0, 1], size=n_samples, p=[0.30, 0.70])
    post_discharge_call = np.random.choice([0, 1], size=n_samples, p=[0.45, 0.55])
    
    # Target Variable: Readmitted_30_Days (~15% base rate)
    log_odds = (
        -3.1
        + 0.025 * age
        + 0.35 * chronic_condition_count
        + 0.45 * prev_admissions
        + 0.30 * er_visits
        + 0.08 * los
        + 0.55 * icu_admission
        - 0.40 * followup_scheduled
    )
    prob_readmit = 1 / (1 + np.exp(-log_odds))
    # Patients who died cannot be readmitted
    prob_readmit[discharge_disp == 'Expired'] = 0.0
    readmitted = (np.random.rand(n_samples) < prob_readmit).astype(int)
    
    # Leakage variable
    days_to_next = np.where(
        readmitted == 1,
        np.random.randint(1, 31, size=n_samples),
        np.random.choice([np.nan, 45, 90, 180], size=n_samples, p=[0.7, 0.1, 0.1, 0.1])
    )
    
    df = pd.DataFrame({
        'Patient_ID': patient_ids,
        'Age': age,
        'Gender': gender,
        'BMI': bmi,
        'Smoking_Status': smoking_status,
        'Marital_Status': marital_status,
        'Diabetes': diabetes,
        'Hypertension': hypertension,
        'Heart_Disease': heart_disease,
        'COPD': copd,
        'Kidney_Disease': kidney_disease,
        'Chronic_Condition_Count': chronic_condition_count,
        'Previous_Admissions': prev_admissions,
        'ER_Visits_Last_12M': er_visits,
        'Specialist_Visits_Last_12M': specialist_visits,
        'Total_Medications': total_medications,
        'Length_Of_Stay': los,
        'ICU_Admission': icu_admission,
        'Surgery_Performed': surgery_performed,
        'Discharge_Disposition': discharge_disp,
        'Total_Claim_Cost': claim_cost,
        'Pharmacy_Cost': pharmacy_cost,
        'Lab_Cost': lab_cost,
        'Imaging_Cost': imaging_cost,
        'Followup_Appointment_Scheduled': followup_scheduled,
        'Post_Discharge_Call_Completed': post_discharge_call,
        'Days_To_Next_Admission': days_to_next,
        'Readmitted_30_Days': readmitted
    })
    
    # --------------------------------------------------------------------------
    # Inject deliberate defects outlined in Phase 2 capstone specifications
    # --------------------------------------------------------------------------
    # Missing values
    df.loc[df.sample(frac=0.06, random_state=1).index, 'BMI'] = np.nan
    df.loc[df.sample(frac=0.04, random_state=2).index, 'Smoking_Status'] = np.nan
    df.loc[df.sample(frac=0.03, random_state=3).index, 'Marital_Status'] = np.nan
    df.loc[df.sample(frac=0.05, random_state=4).index, 'Pharmacy_Cost'] = np.nan
    
    # Invalid values
    df.loc[df.sample(n=25, random_state=5).index, 'Age'] = 145
    df.loc[df.sample(n=15, random_state=6).index, 'Age'] = -3
    df.loc[df.sample(n=30, random_state=7).index, 'Length_Of_Stay'] = -4
    
    # Extreme Outliers
    df.loc[df.sample(n=5, random_state=8).index, 'Total_Claim_Cost'] = 750000.0
    
    # Duplicate rows (IDs)
    duplicates = df.sample(n=120, random_state=9)
    df = pd.concat([df, duplicates], ignore_index=True)
    
    return df

