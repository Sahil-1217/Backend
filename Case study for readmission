# Define Features and Target
X = feat_df.drop(columns=['Readmitted_30_Days', 'Cluster'])
y = feat_df['Readmitted_30_Days']

categorical_cols = X.select_dtypes(include=['object', 'category']).columns.tolist()
numeric_cols = X.select_dtypes(include=['int32', 'int64', 'float64']).columns.tolist()

# Train/Test Split (80/20 Stratified)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

preprocessor = ColumnTransformer(transformers=[
    ('num', StandardScaler(), numeric_cols),
    ('cat', OneHotEncoder(drop='first', handle_unknown='ignore'), categorical_cols)
])

# Candidate models
models = {
    'Logistic Regression': LogisticRegression(max_iter=1000, class_weight='balanced', random_state=42),
    'Random Forest': RandomForestClassifier(n_estimators=150, max_depth=8, class_weight='balanced', random_state=42, n_jobs=-1),
    'Gradient Boosting': GradientBoostingClassifier(n_estimators=120, max_depth=4, learning_rate=0.08, random_state=42),
    'XGBoost': XGBClassifier(n_estimators=150, max_depth=4, learning_rate=0.08, scale_pos_weight=5.5,
                             eval_metric='logloss', random_state=42, n_jobs=-1)
}

trained_pipes = {}
model_eval_summary = []

for name, clf in models.items():
    pipe = Pipeline([
        ('prep', preprocessor),
        ('clf', clf)
    ])
    pipe.fit(X_train, y_train)
    trained_pipes[name] = pipe
    
    y_pred_proba = pipe.predict_proba(X_test)[:, 1]
    y_pred = pipe.predict(X_test)
    
    auc = roc_auc_score(y_test, y_pred_proba)
    acc = accuracy_score(y_test, y_pred)
    prec = precision_score(y_test, y_pred, zero_division=0)
    rec = recall_score(y_test, y_pred)
    f1 = f1_score(y_test, y_pred)
    
    model_eval_summary.append({
        'Model': name,
        'ROC-AUC': round(auc, 4),
        'F1-Score': round(f1, 4),
        'Recall': round(rec, 4),
        'Precision': round(prec, 4),
        'Accuracy': round(acc, 4)
    })

print("\n" + "=" * 80)
print("                   BASELINE MODEL PERFORMANCE BENCHMARK                    ")
print("=" * 80)
print(pd.DataFrame(model_eval_summary).to_string(index=False))

# ------------------------------------------------------------------------------
# Hyperparameter Tuning on XGBoost via Stratified 5-Fold Grid Search
# ------------------------------------------------------------------------------
xgb_pipe = Pipeline([
    ('prep', preprocessor),
    ('xgb', XGBClassifier(eval_metric='logloss', scale_pos_weight=5.5, random_state=42, n_jobs=-1))
])

param_grid = {
    'xgb__max_depth': [3, 5],
    'xgb__learning_rate': [0.03, 0.08],
    'xgb__n_estimators': [100, 180]
}

cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
grid_search = GridSearchCV(xgb_pipe, param_grid, cv=cv, scoring='roc_auc', n_jobs=-1, verbose=0)
grid_search.fit(X_train, y_train)

best_model = grid_search.best_estimator_
print(f"\n[*] Optimal XGBoost Hyperparameters: {grid_search.best_params_}")
print(f"[*] Best 5-Fold Stratified Cross-Validation ROC-AUC: {grid_search.best_score_:.4f}")


# ==============================================================================
# CELL 8: PHASE 10, 11 & 12 - EVALUATION, THRESHOLD TUNING & FEATURE IMPORTANCE
# ==============================================================================
y_test_proba = best_model.predict_proba(X_test)[:, 1]

# 1. Custom Decision Threshold Calibration (Prioritizing Clinical Recall)
target_recall = 0.75
precisions, recalls, thresholds = precision_recall_curve(y_test, y_test_proba)
idx = np.where(recalls >= target_recall)[0][-1]
optimal_thresh = thresholds[idx]

y_pred_calibrated = (y_test_proba >= optimal_thresh).astype(int)

print("\n" + "=" * 80)
print(f"       OPERATIONAL PERFORMANCE REPORT (Calibrated Threshold = {optimal_thresh:.3f})")
print("=" * 80)
print(classification_report(y_test, y_pred_calibrated, target_names=['Not Readmitted', 'Readmitted']))
print(f"Operational ROC-AUC Score: {roc_auc_score(y_test, y_test_proba):.4f}")

# 2. Confusion Matrix & ROC Curve Visualization
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))

cm = confusion_matrix(y_test, y_pred_calibrated)
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=ax1,
            xticklabels=['Pred 0', 'Pred 1'], yticklabels=['Actual 0', 'Actual 1'])
ax1.set_title(f'Confusion Matrix @ p={optimal_thresh:.2f}', weight='bold')

fpr, tpr, _ = roc_curve(y_test, y_test_proba)
ax2.plot(fpr, tpr, color='#2b5c8f', lw=2, label=f'Tuned XGBoost (AUC = {roc_auc_score(y_test, y_test_proba):.3f})')
ax2.plot([0, 1], [0, 1], color='navy', lw=1.5, linestyle='--')
ax2.set_xlabel('False Positive Rate (1 - Specificity)')
ax2.set_ylabel('True Positive Rate (Recall)')
ax2.set_title('Test Set ROC Curve', weight='bold')
ax2.legend(loc="lower right")
plt.tight_layout()
plt.show()

# 3. Top Feature Importance Extraction
encoded_cat_names = best_model.named_steps['prep'].named_transformers_['cat'].get_feature_names_out(categorical_cols).tolist()
all_feature_names = numeric_cols + encoded_cat_names
importances = best_model.named_steps['xgb'].feature_importances_

feat_imp_df = pd.DataFrame({'Feature': all_feature_names, 'Importance': importances})
feat_imp_df = feat_imp_df.sort_values('Importance', ascending=False).head(10)

plt.figure(figsize=(10, 4.5))
sns.barplot(x='Importance', y='Feature', data=feat_imp_df, palette='Blues_r')
plt.title('Top 10 Most Predictive Features for 30-Day Readmission', weight='bold')
plt.xlabel('XGBoost Relative Gain / Feature Importance')
plt.tight_layout()
plt.show()



